# Search worker/release config
# Use a Meilisearch key that can write settings and documents for sync:meilisearch/release:search.
# Browser deployments should copy only a public search key into search/search-config.js.
MEILISEARCH_HOST=https://search.example.org
MEILISEARCH_KEY=meilisearch-write-key
MEILI_DOCUMENT_INDEX=dprk_documents
MEILI_SUGGESTION_INDEX=dprk_suggestions

# Source crawling and asset mirroring
HTTP_PROXY=http://34.11.153.107:3128
HTTPS_PROXY=http://34.11.153.107:3128
NO_PROXY=
DPRK_SEARCH_PROXY_DIRECT_FALLBACK=1

# Same-origin /api/search-asset outbound proxy on Vercel or another Node host
DPRK_SEARCH_ASSET_PROXY=http://34.11.153.107:3128

# Public deployed search portal used by verify:search-production/release:search
DPRK_SEARCH_PUBLIC_BASE_URL=https://nkarchive.vercel.app

# Cloudflare R2 search asset upload
R2_PUBLIC_BASE_URL=https://pub-example.r2.dev
R2_OBJECT_PREFIX=search/assets
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=nkarchive-search-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Optional non-interactive Vercel production deploy from release:search --deploy-vercel --confirm-production
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_PRODUCTION_URL=
