{
  "functions": {
    "api/news-comments.js": {
      "maxDuration": 30,
      "includeFiles": "data/news/details/*.json"
    },
    "api/news-document.js": {
      "maxDuration": 30,
      "includeFiles": "{data/news/details/*.json,news/document-template.html}"
    },
    "api/news-image.js": {
      "maxDuration": 30,
      "includeFiles": "data/news/image-proxy-allowlist.json"
    },
    "api/news-latest.js": {
      "maxDuration": 30,
      "includeFiles": "{data/news-feed.json,data/news/search-index.json,scripts/news-mirror-crawler.ts,lib/news-image-policy.js}"
    },
    "api/news-youtube-latest.js": {
      "maxDuration": 30
    },
    "api/search-asset.js": {
      "maxDuration": 30
    },
    "api/search-live.js": {
      "maxDuration": 30
    },
    "api/search-live-image.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/search",
      "destination": "/search/index.html"
    },
    {
      "source": "/search/",
      "destination": "/search/index.html"
    },
    {
      "source": "/search/results",
      "destination": "/search/results/index.html"
    },
    {
      "source": "/search/results/",
      "destination": "/search/results/index.html"
    },
    {
      "source": "/search/document",
      "destination": "/search/document/index.html"
    },
    {
      "source": "/search/document/",
      "destination": "/search/document/index.html"
    },
    {
      "source": "/font",
      "destination": "/font/index.html"
    },
    {
      "source": "/music",
      "destination": "/music/index.html"
    },
    {
      "source": "/news/category",
      "destination": "/news/category/index.html"
    },
    {
      "source": "/news/category/",
      "destination": "/news/category/index.html"
    },
    {
      "source": "/news/search",
      "destination": "/news/search/index.html"
    },
    {
      "source": "/news/search/",
      "destination": "/news/search/index.html"
    },
    {
      "source": "/news/youtube",
      "destination": "/news/youtube/index.html"
    },
    {
      "source": "/news/youtube/",
      "destination": "/news/youtube/index.html"
    },
    {
      "source": "/news/document",
      "destination": "/api/news-document"
    },
    {
      "source": "/news/document/",
      "destination": "/api/news-document"
    },
    {
      "source": "/news",
      "destination": "/news/index.html"
    },
    {
      "source": "/news/",
      "destination": "/news/index.html"
    },
    {
      "source": "/live",
      "destination": "/live/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/news-feed.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/data/news-details.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/data/news/search-index.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/data/news/youtube-videos.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=60"
        }
      ]
    },
    {
      "source": "/data/news/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/news-image",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/search-asset",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/search/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/search/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/search/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
